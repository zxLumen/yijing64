# 网页版服务端环境变量。默认值可跑 demo,上线前务必设置。
# cp .env.example .env —— .env 已被 .gitignore 忽略,不会入库。

# 端口(容器内固定 8788;compose 通过 yijing:8788 反代)
YIJING_PORT=8788
YIJING_HOST=0.0.0.0

# 运行期数据目录(记录 / AI 配置 / Key / owner token)
# 容器内为 /data(命名卷);本地默认 web/data
YIJING_DATA_DIR=./data

# 放行访客使用 AI(走站长配的 provider);=0 关闭
YIJING_VISITOR_AI=1

# 博客登录态 SSO 用的签名密钥,须与博客的 SESSION_SECRET 一致。
# 配置后,已登录博客(zx_admin cookie,域 .zxlumen.cn)即视为站长。
# 留空则只能用 owner token 兜底链接。
SESSION_SECRET=

# 站长兜底 token:留空则首次启动在 YIJING_DATA_DIR/owner.token 生成并打印
#YIJING_OWNER_TOKEN=

# 大模型经博客 AI 网关(令牌在博客 admin「AI 密钥」页生成后填这里)。
# 不填 ZX_AI_GATEWAY_URL 时默认 http://localhost:3000/api/ai/v1(本地);
# 线上容器内由 docker-compose 注入 http://app:3000/api/ai/v1。
ZX_AI_GATEWAY_URL=
ZX_AI_APP_TOKEN=
